# Install to /etc/sparkrustler.env, mode 0600, owned by root.
#
# Every setting has a command-line flag; the environment is preferred
# here so the broker password is not visible in the unit file or in ps.
# Run `sparkrustler -h` for the full list.

# Identity. Defaults to the short hostname, which is usually right.
#SPARKRUSTLER_NODE_ID=spark-a23e
SPARKRUSTLER_DEVICE_MODEL=DGX Spark (GB10)

# The vLLM server on this node.
SPARKRUSTLER_VLLM_URL=http://localhost:8000

# The broker.
SPARKRUSTLER_BROKER=tcp://mqtt.example.net:1883
SPARKRUSTLER_USERNAME=sparkrustler
SPARKRUSTLER_PASSWORD=

# How often state is published. The watchdog pings independently, so a
# longer interval here does not risk being killed.
SPARKRUSTLER_INTERVAL=15s

#SPARKRUSTLER_LOG_LEVEL=info
