# Install to /etc/sparkwrangler.env, mode 0600, owned by root.
#
# Every setting has a command-line flag; the environment is preferred
# here so the broker password is not visible in the unit file or in ps.
# Run `sparkwrangler -h` for the full list.

# Identity. Defaults to the short hostname, which is usually right.
#SPARKWRANGLER_NODE_ID=spark-01
SPARKWRANGLER_DEVICE_MODEL=DGX Spark (GB10)

# The interface whose MAC address identifies this node to Home Assistant,
# which uses it to recognise this device as a machine it already knows
# from DHCP or the router. Unset picks the port carrying the default
# route, which is the one anything else on the network can see — set it
# only if that choice is wrong.
#SPARKWRANGLER_NET_INTERFACE=enp1s0

# The vLLM server on this node.
#
# Leave it EMPTY on a node that runs no engine of its own. On a
# tensor-parallel cluster only the head node serves the API; the others
# hold half the weights and do the same work, but have nothing to ask
# about serving. An empty value puts the daemon in worker mode, where it
# publishes accelerator and host readings and declares no serving
# entities at all — rather than a dozen sensors that can only ever read
# unknown.
SPARKWRANGLER_VLLM_URL=http://localhost:8000

# The address Home Assistant links to on the device page. Deliberately
# not derived from the vLLM URL above, which is loopback and would send
# whoever clicks it to their own machine. Unset publishes no link.
#SPARKWRANGLER_CONFIG_URL=http://spark-01.example.net:8000

# The broker. Prefer mqtts:// — the credentials below cross this link,
# and a plaintext scheme sends them in the clear. The daemon warns at
# startup when a password is configured against a plaintext URL.
SPARKWRANGLER_BROKER=mqtts://mqtt.example.net:8883
SPARKWRANGLER_USERNAME=sparkwrangler
SPARKWRANGLER_PASSWORD=

# A broker with a private or self-signed CA — which is most home
# installations, including Home Assistant's Mosquitto add-on — needs its
# CA here. Without it, verification falls back to the system trust store
# and will fail.
#SPARKWRANGLER_CA_FILE=/etc/ssl/certs/home-ca.pem

# Mutual TLS, where the broker authenticates this client by certificate.
#SPARKWRANGLER_TLS_CERT=/etc/sparkwrangler/client.pem
#SPARKWRANGLER_TLS_KEY=/etc/sparkwrangler/client-key.pem

# When the broker is reached by an address its certificate does not name.
#SPARKWRANGLER_TLS_SERVERNAME=mqtt.example.net

# Debugging a first connection only. With this set, any host answering on
# that address is trusted, and the daemon says so loudly at every start.
#SPARKWRANGLER_TLS_INSECURE=false

# How often state is published. The watchdog pings independently, so a
# longer interval here does not risk being killed.
SPARKWRANGLER_INTERVAL=15s

#SPARKWRANGLER_LOG_LEVEL=info
